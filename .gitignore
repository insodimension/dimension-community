node_modules/
dist/
# Component packs COMMIT their built bundle: a pack must be installable with no
# build step, because the host loads `dist/index.mjs` at runtime (doc 68 §16.2).
!packs/*/dist/
!packs/browser/app/dist/
!packs/swiss-knife/viewer/app/dist/
# Local verification harnesses and cached upstream sources: developer scratch,
# never part of the published pack.
.dev/
# The browser pack's Python task worker environment (`cd packs/browser/python && uv sync`).
packs/browser/python/.venv/
# The patched puppeteer-core a source run bundles on first use (packs/browser/src/engines/agent-puppeteer.ts).
packs/browser/.cache/
__pycache__/
