{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "artifactory-general-agent",
	"version": "0.5.0",
	"description": "See every agent you can run as a card with its face and its week at a glance, open one to edit it, or ask the Machinist to draft a new one.",
	"keywords": [
		"general-agents",
		"agent-builder",
		"component"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.19" },
			"title": "General Agents",
			"icon": "bot",
			"artifactories": [
				{
					"mcpServer": "general-agent",
					"label": "General Agents",
					"icon": "bot",
					"modelSpaces": [
						"code",
						"build",
						"example-hub",
						"phone",
						"traction"
					]
				}
			],
			"entry": "dist/index.mjs",
			"type": "component",
			"components": [
				{
					"id": "general-agents-page",
					"label": "General Agents",
					"slot": "workspace-surface",
					"export": "GeneralAgentsPage",
					"opens": ["agent"],
					"grants": [
						"artifactory:call",
						"agents:configure",
						"agents:rename"
					]
				}
			],
			"railActions": [
				{
					"id": "general-agents",
					"label": "General Agents",
					"icon": "bot",
					"order": 20,
					"target": "page",
					"surface": "page",
					"component": "general-agents-page",
					"session": {
						"agent": "machinist"
					}
				}
			]
		}
	}
}
