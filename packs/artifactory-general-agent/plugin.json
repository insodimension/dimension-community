{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "artifactory-general-agent",
	"version": "0.4.0",
	"description": "General Agents: every agent you can run, as cards with their real faces and their week at a glance. Open one for its whole profile (face, charter, standing instructions, skills, plugins, MCP, tools, memory, home, models and safety) and edit it there, extend a pack's agent into your own, or ask the Machinist to draft one.",
	"keywords": [
		"general-agents",
		"agent-builder",
		"component"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "General Agents",
			"icon": "bot",
			"artifactories": [
				{
					"mcpServer": "general-agent",
					"label": "General Agents",
					"icon": "bot",
					"modelSpaces": [
						"code",
						"build",
						"example-hub",
						"phone",
						"traction"
					]
				}
			],
			"entry": "dist/index.mjs",
			"type": "component",
			"components": [
				{
					"id": "general-agents-page",
					"label": "General Agents",
					"slot": "workspace-surface",
					"export": "GeneralAgentsPage",
					"grants": [
						"artifactory:call",
						"agents:configure"
					]
				}
			],
			"railActions": [
				{
					"id": "general-agents",
					"label": "General Agents",
					"icon": "bot",
					"order": 20,
					"target": "page",
					"surface": "page",
					"component": "general-agents-page",
					"session": {
						"agent": "machinist"
					}
				}
			]
		}
	}
}
