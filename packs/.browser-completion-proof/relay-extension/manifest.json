{
	"manifest_version": 3,
	"name": "Dimension Browser Relay",
	"version": "0.1.0",
	"description": "Lets Dimension's Browser pack drive your existing Chrome tabs through a local CDP relay.",
	"permissions": [
		"debugger",
		"tabs",
		"tabGroups",
		"storage",
		"alarms"
	],
	"background": {
		"service_worker": "background.js"
	},
	"options_page": "options.html",
	"action": {
		"default_title": "Dimension Browser Relay (click for settings)"
	}
}
