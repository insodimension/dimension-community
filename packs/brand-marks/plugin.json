{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "brand-marks",
	"version": "0.2.0",
	"description": "Brand Marks — ten presence avatars (X, Reddit, YouTube, Discord, Y Combinator, Product Hunt, Bluesky, Threads, Instagram, TikTok) for the avatar slot: the official mark, unmodified at rest, with container-only motion that follows the session.",
	"author": {
		"name": "Dimension"
	},
	"license": "MIT",
	"keywords": [
		"avatar",
		"vibr",
		"presence",
		"component",
		"brand"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "Brand Marks",
			"category": "component",
			"icon": "assets/icon.svg",
			"requires": {
				"dimension": ">=0.10.22"
			},
			"entry": "dist/avatar.js",
			"type": "component",
			"components": [
				{
					"id": "x",
					"slot": "avatar",
					"label": "X"
				},
				{
					"id": "reddit",
					"slot": "avatar",
					"label": "Reddit"
				},
				{
					"id": "youtube",
					"slot": "avatar",
					"label": "YouTube"
				},
				{
					"id": "discord",
					"slot": "avatar",
					"label": "Discord"
				},
				{
					"id": "ycombinator",
					"slot": "avatar",
					"label": "Y Combinator"
				},
				{
					"id": "producthunt",
					"slot": "avatar",
					"label": "Product Hunt"
				},
				{
					"id": "bluesky",
					"slot": "avatar",
					"label": "Bluesky"
				},
				{
					"id": "threads",
					"slot": "avatar",
					"label": "Threads"
				},
				{
					"id": "instagram",
					"slot": "avatar",
					"label": "Instagram"
				},
				{
					"id": "tiktok",
					"slot": "avatar",
					"label": "TikTok"
				}
			]
		}
	}
}
