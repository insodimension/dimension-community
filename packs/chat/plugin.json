{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "chat",
	"version": "0.2.7",
	"description": "A calm space for talking to Aether, with no code or branches in sight, your past sessions listed and a viewer for the documents, slides and images it makes.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"layout",
		"space",
		"assistant",
		"personal",
		"chat"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"title": "Chat",
			"category": "layout",
			"defaultEnabled": true,
			"channel": "canary",
			"spaces": [
				{
					"specVersion": 1,
					"id": "chat",
					"label": "Chat",
					"icon": "aether",
					"order": 35,
					"description": "Your personal assistant in a room of its own: a calm conversation, your past sessions on the left, and whatever it makes for you opening beside it.",
					"preview": {
						"screenshots": [
							"assets/preview/chat-start.webp",
							"assets/preview/chat-call.webp"
						],
						"tagline": "Your assistant in a room of its own, with a face you can talk to."
					},
					"showcase": {
						"summary": "A calm conversation with Aether, your past sessions beside it, and whatever it makes opening next to it. Open Face to face to talk it through out loud, or start a live call that hands anything about your work to your agent.",
						"video": {
							"src": "assets/preview/chat-loop.mp4",
							"poster": "assets/preview/chat-call.webp"
						},
						"onboarding": "Send a first message, then open Face to face to talk."
					},
					"mark": {
						"accent": "#e8a838"
					},
					"layout": "chat",
					"components": {
						"ch-switcher": "classic-switcher",
						"ch-rail": "chat-rail",
						"ch-workspace": "classic-workspace",
						"face": "face-to-face"
					},
					"rail": {
						"actions": [
							{
								"id": "new-session",
								"label": "New session",
								"icon": "plus",
								"target": "new-session",
								"kbd": "Cmd+N",
								"primary": true
							},
							{
								"id": "face",
								"label": "Face to face",
								"icon": "waveform",
								"target": "surface",
								"surface": "face"
							}
						]
					},
					"workspace": {
						"surfaces": [
							"session",
							"face"
						],
						"chrome": {
							"face": "none"
						},
						"start": "session",
						"session": "session",
						"actions": [
							"sound"
						],
						"scope": {
							"workspace": "inso-personal"
						},
						"sections": {
							"thread": "chat-thread",
							"composer": "independent-composer",
							"start": "classic-start"
						},
						"startCopy": {
							"heading": "What can I help you with today?"
						},
						"composer": {
							"startPlaceholder": "Ask anything, or tell me what you need…",
							"placeholder": "Reply, or ask for something else…",
							"tips": []
						}
					},
					"generalAgents": {
						"list": [
							"aether"
						],
						"default": "aether"
					},
					"requires": {
						"plugins": [
							"classic-switcher",
							"chat-rail",
							"classic-workspace",
							"chat-thread",
							"independent-composer",
							"classic-start",
							"swiss-knife",
							"generative-ui",
							"face-to-face"
						]
					}
				}
			],
			"type": "layout",
			"slots": [
				{
					"id": "ch-switcher",
					"contract": "switcher"
				},
				{
					"id": "ch-rail",
					"contract": "rail",
					"items": "sessions"
				},
				{
					"id": "ch-workspace",
					"contract": "workspace"
				},
				{
					"id": "ch-artifact-view",
					"contract": "artifact-view"
				}
			]
		}
	}
}
