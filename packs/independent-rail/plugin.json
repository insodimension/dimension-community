{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "independent-rail",
	"version": "0.1.4",
	"description": "An example session list built only from the public UI parts, to show how to build your own.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"rail",
		"independent"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.5" },
			"title": "Independent Rail",
			"icon": "panel",
			"category": "component",
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "rail"
		}
	}
}
