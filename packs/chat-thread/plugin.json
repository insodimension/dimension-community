{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "chat-thread",
	"version": "0.1.6",
	"description": "The conversation view for the Chat space: your words and the assistant's, one quiet \"Worked for\" line per turn and a card for any file or interface it shows you.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"thread",
		"conversation",
		"chat"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.19" },
			"title": "Chat Thread",
			"icon": "messageSquare",
			"category": "component",
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "thread"
		}
	}
}
