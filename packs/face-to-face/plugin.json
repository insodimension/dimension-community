{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "face-to-face",
	"version": "0.1.8",
	"description": "Talk to your agent and watch it answer: a full-screen face that lip-syncs to the real audio and captions every word as it is spoken. Where available, Talk live adds a real-time voice.",
	"author": {
		"name": "Dimension"
	},
	"license": "MIT",
	"keywords": [
		"component",
		"workspace-surface",
		"voice",
		"face to face"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.16" },
			"title": "Face to face",
			"icon": "waveform",
			"category": "component",
			"defaultEnabled": true,
			"channel": "canary",
			"entry": "dist/index.mjs",
			"type": "component",
			"components": [
				{
					"id": "face-to-face",
					"slot": "workspace-surface",
					"label": "Face to face"
				},
				{
					"id": "face-to-face-door",
					"slot": "workspace-surface",
					"export": "FaceDoor",
					"label": "Face to face door"
				}
			]
		}
	}
}
