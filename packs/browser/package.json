{
  "name": "@dimension/community-browser",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "author": "Dimension",
  "description": "A browser MCP App the agent and the human share: tabs, named persistent profiles, visual annotations into the same session, and, where jev's key is configured, whole tasks handed to jev.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:types": "tsc --noEmit && tsc --noEmit -p src/dock",
    "test": "bun test test/",
    "start": "node app/server.mjs"
  },
  "dimension": {
    "name": "browser",
    "description": "A real browser beside your chat that your agent drives while you watch. Tabs, persistent logged-in profiles, circle-to-annotate, and an optional fast task agent (jev).",
    "defaultEnabled": false,
    "category": "artifactory",
    "keywords": ["browser", "mcp-apps", "profiles", "annotations"]
  },
  "files": ["plugin.json", "ai.insodimension.dimension/", "app/server.mjs", "app/code-worker.mjs", "app/dist/", "dist/", "recipes/", "relay-extension/", "python/dim_browser_bridge/", "python/pyproject.toml", "python/uv.lock", "skills/", "README.md"],
  "dependencies": {
    "@babel/parser": "7.29.7",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@puppeteer/browsers": "3.2.2",
    "puppeteer-core": "25.11.0",
    "tldts": "7.4.15",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@dimension/mcp-app-kit": "workspace:*",
    "@dimension/sdk": "workspace:*",
    "@fraym/ui": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "esbuild": "^0.21.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
