{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "rooms-rail",
	"version": "0.1.4",
	"description": "The session list for rooms spaces: the space's own header, direct messages, channels and projects, an Organise menu and a marker on rows that need you.",
	"author": {
		"name": "Dimension"
	},
	"keywords": [
		"component",
		"rail",
		"rooms"
	],
	"extensions": {
		"ai.insodimension.dimension": {
			"contractVersion": 1,
			"requires": { "dimension": ">=0.11.12" },
			"title": "Rooms Rail",
			"icon": "chat",
			"category": "component",
			"defaultEnabled": true,
			"entry": "dist/index.mjs",
			"type": "component",
			"slot": "rail"
		}
	}
}
